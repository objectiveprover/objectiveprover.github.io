---
import { Font } from "astro:assets";
import "@/styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Cognitive Designer" />
    <Font cssVariable="--font--swiza" />
  </head>
  <body>
    <slot />
  </body>
</html>
