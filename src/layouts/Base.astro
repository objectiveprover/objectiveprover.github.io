---
import { Font } from "astro:assets";
import "@/styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Cognitive Designer · Web Developer since 2013" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font--swiza" />
  </head>
  <body>
    <aside class="banner">
      <div class="container">
        <p>I’m currently available for contract work. If you need a faster, cleaner, more usable website, email me through the Contact link on this page.</p>
      </div>
    </aside>

    <div class="container">
      <slot />
    </div>
  </body>
</html>
