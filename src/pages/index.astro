---
import Base from "@/layouts/Base.astro";
import Header from "@/components/sections/Header.astro";
import WebDevelopment from "@/components/sections/WebDevelopment.astro";
import Minimalist from "@/components/sections/Minimalist.astro";
import Programming from "@/components/sections/Programming.astro";
import TechnicalWriting from "@/components/sections/TechnicalWriting.astro";

const title = "Jaime Hernández—Cognitive Designer · Web Developer since 2013";

const year = new Date().getFullYear();
---

<Base title={title}>
  <main id="main">
    <Header
      nav={[
        { id: "web-development", label: "Web Development" },
        { id: "programming", label: "Programming" },
        { id: "the-minimalist", label: "The Minimalist" },
        { id: "technical-writing", label: "Technical Writing" },
      ]}
    />

    <WebDevelopment />
    <Programming />
    <Minimalist />
    <TechnicalWriting />
  </main>

  <footer class="colophon">
    <p class="copyright">Copyright {year}, Jaime Hernández</p>
    <a href="mailto:contact@jaime.one">Contact</a>
  </footer>

  <p style="margin-bottom: var(--space-l);"><small><em>Disclaimer</em>: AI was <strong>only</strong> used for grammar suggestions on my own writing, and to turn the photo of my lab into a drawing-like picture.</small></p>
</Base>
