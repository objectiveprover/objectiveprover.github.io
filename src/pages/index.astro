---
import Base from "@/layouts/Base.astro";
import Header from "@/components/sections/Header.astro";
import WebDevelopment from "@/components/sections/WebDevelopment.astro";
import Design from "@/components/sections/Design.astro";
import Programming from "@/components/sections/Programming.astro";
import TechnicalWriting from "@/components/sections/TechnicalWriting.astro";
import CognitiveDesigner from "@/components/sections/CognitiveDesigner.astro";

const title = "Jaime Hernández—Cognitive Designer · Web Developer since 2013";

const year = new Date().getFullYear();
---

<Base title={title}>
  <main id="main" class="container">
    <Header
      nav={[
        { id: "web-development", label: "1—Web Development" },
        { id: "design", label: "2—Design" },
        { id: "programming", label: "3—Programming" },
        { id: "technical-writing", label: "4—Technical Writing" },
        { id: "cognitive-designer", label: "5—What Is a Cognitive Designer" },
      ]}
    />

    <WebDevelopment />
    <Design />
    <Programming />
    <TechnicalWriting />
    <CognitiveDesigner />
  </main>

  <footer class="container">
    <div class="colophon">
      <div>
        <p class="copyright">Copyright {year}, Jaime Hernández</p>
      </div>
      <a href="mailto:contact@jaime.one">Contact</a>
    </div>
  </footer>
</Base>
