---
// Renders the image when `src` is given; otherwise a placeholder with the
// same aspect ratio
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src?: ImageMetadata;
  alt: string;
  /** CSS aspect-ratio of the image, e.g. "3 / 2". */
  ratio: string;
  eager?: boolean;
  class?: string;
}

const { src, alt, ratio, eager = false, class: className } = Astro.props;
const hasCaption = Astro.slots.has("default");
---

<figure class:list={["figure", className]}>
  {
    src ? (
      <Image src={src} alt={alt} loading={eager ? "eager" : "lazy"} />
    ) : (
      <div class="placeholder" style={`aspect-ratio: ${ratio};`} role="img" aria-label={alt}>
        <span aria-hidden="true">{alt}</span>
      </div>
    )
  }
  {hasCaption && <figcaption><slot /></figcaption>}
</figure>

<style>
    figure {
        margin-bottom: var(--space-s);
    }

    figcaption {
        line-height: 1.4;
        text-align: right;
        font-size: var(--font-size--1);
        letter-spacing: 0;
        font-weight: 400;
        max-width: 50ch;
        margin-left: auto;
        margin-top: 2rem;
        font-style: italic;

        a {
            text-decoration: underline;
        }
    }
</style>