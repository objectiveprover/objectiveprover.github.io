---
interface Props {
  id: string;
  title: string;
  /** Remove the bottom padding. */
  flush?: boolean;
}

const { id, title, flush = false } = Astro.props;
---

<!-- The number before the title comes from a CSS counter (see global.css) -->
<section id={id} class:list={["page-section", { flush }]} aria-labelledby={`${id}-h`}>
  <h2 id={`${id}-h`}><span class="index"></span>&nbsp;&nbsp;{title}</h2>
  <slot />
</section>

<style>
.flush {
  padding-bottom: 0;
}
</style>
