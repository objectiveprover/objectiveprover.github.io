---
import conciseImage from "@/assets/concisecss.jpg";
import Figure from "@/components/Figure.astro"

type Link = {
  label: string;
  url?: string;
}


type Client = {
  name: string;
  url?: string;
  what: string;
  scope: string[];
  collaborators?: Link[];
  design?: Link;
}

// "A", "A and B", "A, B and C"
const withSeparators = (list: Link[]) =>
  list.map((p, i) => ({
    ...p,
    sep: i === 0 ? "" : i === list.length - 1 ? " and " : ", ",
  }));

const keenan: Link = {
  label: "Keenan Payne",
  url: "https://keenanpayne.com"
};

const nels: Link = {
  label: "Nels Andereck",
  url: "https://www.nelsandereck.com/"
};

const family: Link = {
  label: "Family Style",
  url: `https://wearefamilystyle.com/cardless`
};

const play = (path = ""): Link =>
  ({ label: "Play", url: `https://play.studio/${path}` });


const clients: Client[] = [
  {
    name: "Neuralink",
    url: "https://neuralink.com/",
    what: "Brain–computer interfaces.",
    scope: ["Implementation", "Maintenance"],
    collaborators: [keenan],
    design: play("work/neuralink"),
  },
  {
    name: "Cardless",
    url: "https://www.cardless.com/",
    what: "Embedded credit card platform.",
    scope: ["Implementation in Framer"],
    collaborators: [keenan],
    design: family,
  },
  {
    name: "Play",
    url: "https://play.studio/",
    what: "Design studio.",
    scope: ["Implementation", "Maintenance"],
    design: { label: "Play (in-house)" },
  },
  {
    name: "Sparrow",
    url: "https://sparrow.com/",
    what: "Employee leave management.",
    scope: ["Implementation", "CMS Integration", "Maintenance"],
    collaborators: [keenan, nels],
    design: play("work/sparrow"),
  },
  {
    name: "Transform",
    url: "https://www.getdbt.com/",
    what: "Metrics layer for data teams. Now part of dbt Labs",
    scope: ["Implementation", "CMS Integration", "Maintenance"],
    collaborators: [keenan],
    design: play(),
  },
  {
    name: "Sanno Capital",
    url: "https://sannocapital.com/",
    what: "Investment firm.",
    scope: ["Implementation", "CMS Integration"],
    collaborators: [keenan],
    design: play(),
  },
  {
    name: "Refactor Capital",
    url: "https://refactor.com/",
    what: "Venture capital firm.",
    scope: ["Implementation", "CMS Integration"],
    collaborators: [keenan, nels],
    design: play("work/refactor"),
  },
  {
    name: "Collective[i]",
    url: "https://collectivei.com/",
    what: "AI-driven sales intelligence.",
    scope: ["Implementation", "CMS Integration"],
    collaborators: [keenan],
    design: play("work/collective-i"),
  },
  {
    name: "Simulmedia",
    url: "https://www.simulmedia.com/",
    what: "TV advertising platform.",
    scope: ["Modernization", "Maintenance", "Code Cleanup"],
    design: { label: "Simulmedia (in-house)" }
  },
  {
    name: "PlayerWON",
    url: "https://www.playerwon.com/",
    what: "In-game advertising platform.",
    scope: ["Modernization", "Maintenance", "Code Cleanup"],
    design: { label: "Simulmedia (in-house)" }
  },
  {
    name: "GetWhys",
    url: "https://www.getwhys.io/",
    what: "AI for customer research.",
    scope: ["Design", "Implementation"],
    collaborators: [keenan],
  },
  {
    name: "Metrus Energy",
    url: "https://metrusenergy.com/",
    what: "Energy-efficiency financing.",
    scope: ["Implementation", "Maintenance"],
    collaborators: [keenan],
    design: { label: "PACT", url: "https://www.pact.studio/" },
  },
  {
    name: "Atinc",
    url: "https://atinc.vc/",
    what: "Venture capital firm.",
    scope: ["Implementation", "Maintenance"],
    collaborators: [keenan],
    design: { label: "Paladar Studio" },
  },
];

---

<section class="page-section" id="web-development" aria-labelledby="web-development-h">
  <h2 id="web-development-h"><span class="index">1&nbsp;&nbsp;</span>Web Development</h2>

  <div class="section-description grid">
    <div class="col-6">
      <p>My career as a web developer started in 2014 building websites for clients as a freelancer. Later on, I started working as a long-term contractor for more ambitious projects in collaboration with other developers and designers.</p>

      <p>My goal from the beginning has been to build websites in the simplest and most effective way possible. That usually meant building most things from scratch in order to know every detail of the system and be able to provide any functionality a client required. Existing tools and platforms were still used based on the client specifications and needs.
      </p>
    </div>

    <div class="col-6">
      <p>
      In recent years, I have switched my focus to maintenance with the purpose of improving the current state of the web:
      </p>

      <ul class="features">
        <li>Update content or add new features without breaking the structure and visual design.</li>
        <li>Clean up a codebase when it has become confusing or difficult to modify.</li>
        <li>Upgrade or remove dependencies as needed.</li>
        <li>Improve performance and implement changes from SEO auditors.</li>
        <li>Full but progressive visual improvements without the cost of a complete redesign.</li>
      </ul>
    </div>

  </div>

  <section class="page-subsection" aria-labelledby="clients-h">
    <h3 id="clients-h"><span class="index">1.1&nbsp;&nbsp;</span>Clients</h3>

    <div class="grid">
      <div class="col-6">
        <p>
          Most of my client work came through two long collaborations: with web developer <a href="https://keenanpayne.com">Keenan Payne</a>,
          and the design studio <a href="https://play.studio/">Play</a>.</p>
      </div>
    </div>

    <ul class="clients grid">
      {
            clients.map((c) => (
              <li class="client col-6">
                <h4>
                  {c.url ? <a href={c.url}>{c.name}</a> : c.name}
                  : <em class="client-what">&nbsp;{c.what}</em>
                </h4>

                {(c.collaborators || c.design) && (
                  <p class="credits">
                    {c.collaborators && (
                      <>
                        With&nbsp;
                        {withSeparators(c.collaborators).map((p) => (
                          <>
                            {p.sep}
                            <a href={p.url}>{p.label}</a>
                          </>
                        ))}
                        .{" "}
                      </>
                    )}

                    {c.design && (
                      <>
                        Design by{" "}
                        {c.design.url ? <a href={c.design.url}>{c.design.label}</a> : c.design.label}.
                      </>
                    )}
                  </p>
                )}

                <ul class="scope-tags">
                  {c.scope.map(tag => <li class="scope-tag">{tag}</li>)}
                </ul>
              </li>
            ))
          }
    </ul>


    <p class="note">
      This is only a partial list of the websites I have built since 2019. Some of these have since been redesigned or replaced. Earlier versions are on the <a href="https://web.archive.org/">Wayback Machine</a>, and I can send links to specific snapshots on request.
    </p>
  </section>

  <section class="page-subsection" aria-labelledby="concise-h">
    <h3 id="concise-h"><span class="index">1.2</span>&nbsp;&nbsp;Concise CSS</h3>

    <div class="grid">
      <div class="col-6">
        <Figure src={conciseImage} alt="The Concise CSS documentation website" ratio="3 / 4" class="framed" />
      </div>

      <div class="col-6">
        <p>
          I started building my own CSS framework in 2014; then I found Concise CSS and noticed
              that Keenan Payne and I had the same vision for it. In 2015 we merged the projects and
              released it as a new, distinctive framework compared to the others available at the
              time: native HTML elements with a normalized design good enough to be used on their
              own, a collection of components with minimal design for easy customization, and utility
              styles for rapid prototyping or component variations.
        </p>
        <p>
          It included a grid system that was more intuitive because it used HTML attributes
              instead of classes, which was unusual at the time, before element attributes became the
              default way to attach data to components.
        </p>
        <p>
          I led the typography-oriented design for the website, following the principles of the
              framework; it was composed mostly of text and code samples. I wrote most of it, and
              Keenan helped with editing and grammar corrections (I didn’t have much experience with
              English yet).
        </p>
        <p>
          The next version grew more ambitious and included its own PostCSS-based toolchain, which
              let us define and auto-calculate custom units for font sizes and element spacing,
              standardizing design systems before CSS custom properties had broad browser support.
        </p>
        <p>
          Concise CSS was even included in some books about web development, including one by
              Larry Ullman, the first author I read about web development as a teenager.</p>
        <p>The project has been frozen for a couple of years, but a new version is still planned to unify all the exiting components and use the latest native CSS features.</p>

        <p class="links">
          <a href="https://github.com/concisecss">GitHub</a>
          <a href="https://concisecss.com/">Website</a>
        </p>
      </div>
    </div>
  </section>
</section>


<style>
.clients {
  list-style: none;
  margin-top: var(--space-2xl);
  row-gap: var(--space-xs);

  a {
    text-decoration: none;
  }
}

.client {
  border-top: var(--line-size-2) solid black;
  padding-top: 0.5em;
  padding-bottom: 1em;
  margin-bottom: 1em;
}

.client-what {
  font-style: normal;
  font-weight: 400;
  letter-spacing: -0.02em;
  color: var(--color-text-secondary);
  text-transform: none;

}

.scope-tags {
  list-style: none;
  display: flex;
  font-size: var(--font-size--1);
  gap: 0.5em;
}

.scope-tag {
  margin-top: 1em;
  border: 1px solid black;
  line-height: 1;
  border-radius: 1em;
  padding: 0.25em 0.5em;
}


@media (max-width: 900px) {
  .scope-tags {
    gap: 0;
    flex-direction: column;
    margin-top: 0.5em;
  }

  .scope-tag {
    margin-top: 0.5em;
  }
}

.note {
  font-size: var(--font-size--1);
  margin-top: var(--space-m);
  text-align: right;
  max-width: 50ch;
  margin-left: auto;
  font-style: italic;
}

.credits {
  font-size: var(--font-size--1);
  margin-top: 0em;
  letter-spacing: 0.01em;
  font-weight: 500;
}

.links {
  a {
    display: inline-block;
  }

  a + a {
    margin-left: 2rem;
  }
}

.features {
  margin-top: 1em;
  margin-left: 1.5em;

  li + li {
    margin-top: 0.5em;
  }
}
</style>
