---
import coverImage from "@/assets/cover.jpg";
import Figure from "@/components/Figure.astro";

type navLink = {
  id: string;
  label: string;
}

interface Props {
  nav: navLink[];
}

const { nav } = Astro.props;

---

<header class="header">
  <div class="top">
    <h1>Jaime Hernández <span class="subtitle">Cognitive Designer</span></h1>
    <a class="contact-link" href="mailto:contact@jaime.one">Contact</a>
  </div>

  <div class="grid">
    <nav class="col-6" aria-labelledby="nav-label">
      <p id="nav-label" class="nav-label small-caps">Navigate to:</p>
      <ul class="toc">
        {nav.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
      </ul>
    </nav>

    <div class="col-6">
      <p>I build and organize systems according to the capacities of the <em>human</em> mind.</p>
      <p>I design and develop clear websites and applications. In programming, I focus on creating tools and reducing complexity. I write about ideas using first principles, and typeset books to make them easier to read.</p>

      <p>My work is about both design and implementation. Things must be clear and easy to understand, with nothing extra and nothing missing.</p>

    </div>
  </div>

  <div class="figure">
    <Figure src={coverImage} alt="Drawing of my electronics lab" ratio="3 / 2" eager class="lab">
      A picture of my lab. There’s nothing like exploring design in physical systems, where the
      constraints are stricter and more complex, dictated by both humans and the laws of physics.
      It brings a new and more objective perspective to my work in digital design.
    </Figure>
  </div>
</header>

<style>
.header {
  margin-top: var(--space-xl);
}

.top {
  display: flex;
  justify-content: space-between;
  margin-bottom: var(--space-4xl);
}

.contact-link {
  text-decoration: none;
  margin-top: 1em;
}

.toc {
  list-style: none;
  line-height: 1.6;

  a {
    text-decoration: none;
  }
}

.nav-label {
  margin-bottom: 1.5rem;
}

.figure {
  margin-top: 10rem;
  margin-right: var(--space-page-margin);
  margin-left: var(--space-page-margin);
}
</style>
