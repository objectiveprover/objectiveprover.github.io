---
import Figure from "@/components/Figure.astro";
import safariExtensionImage from "@/assets/safari_extension.jpg";

type Link = {
  label: string;
  url?: string;
}

const books = [
  {
    title: "White Nights",
    author: "Fyodor Dostoevsky",
    cover: whiteNightsImage,
    url: "https://objectiveink.gumroad.com/l/whitenights",
    alt: "Cover and interior spread of my edition of White Nights",
  },
  {
    title: "The Sorrows of Young Werther",
    author: "Johann Wolfgang von Goethe",
    cover: wertherImage,
    url: "https://objectiveink.gumroad.com/l/werther",
    alt: "Cover and interior spread of my edition of The Sorrows of Young Werther",
  },
];

import wertherImage from "@/assets/werther.jpg";
import whiteNightsImage from "@/assets/whitenights.jpg";

---

<section id="the-minimalist" class="page-section" aria-labelledby="the-minimalist-h">
  <h2 id="the-minimalist-h"><span class="index">3</span>&nbsp;&nbsp;The Minimalist</h2>

  <div class="grid">
    <div class="col-6">
      <p>
        <em>The Minimalist</em> is the brand name I use for my products across fields: websites, software, books, and eventually hardware.
      </p>
      <p>
        Most of what I do begins with something that already exists and has a proper essence; my work is to extract that essence and remove everything unnecessary or complex. But when there is nothing to build upon, I try to create something new that’s more effective than the alternatives.
      </p>

    </div>

    <div class="col-6">
      <p>
        It isn’t a style I apply on top of things. It’s what remains when I hold every piece to one standard: every element necessary, nothing arbitrary, and the whole organized around a single principle.
      </p>
      <p>
         A website should provide information clearly. An application should do its job and get out of the way. A novel told in letters should read like letters. Everything must have a purpose, and have the integrity to stick to it.
      </p>
    </div>

  </div>

  <section class="page-subsection" aria-labelledby="minimalist-h">
    <h3 id="minimalist-h"><span class="index">3.1</span>&nbsp;&nbsp;Lens</h3>
    <div class="grid">
      <div class="col-6">
        <Figure
          src={safariExtensionImage}
          alt="The CTAN page for the microtype package, restyled by the Minimalist Lens extension"
          ratio="8 / 5"
          class="offset"
        >
          See the <a href="https://ctan.org/pkg/microtype" target="_blank">original page</a> for the example shown in this picture.
        </Figure>
      </div>
      <div class="col-6">
        <p>
          An experimental Safari extension written in Swift and JavaScript that modifies the design of content-based websites: typography-oriented, no ornamentation; only what’s necessary
            to make the content the main subject and keep it as legible as possible.
        </p>
        <p>Currently on hold to adopt The Minimalist brand. Chrome port in progress.</p>

        <p class="links">
          <a href="https://apps.apple.com/us/app/minimalist-design/id6765779070?mt=12">See on the App Store</a>
        </p>
      </div>
    </div>
  </section>

  <section class="page-subsection" aria-labelledby="typography-h">
    <h3 id="typography-h"><span class="index">3.2</span>&nbsp;&nbsp;Books</h3>
    <div class="grid">
      <div class="col-6">
        <p>
          A collection of well-typeset editions of public domain books. Their purpose is to make reading more enjoyable, to retain attention, and to reflect the tone of the stories through their design.
        </p>
      </div>
      <div class="col-6">
        These books are published as PDF files to maintain a fixed layout and make sure everything remains organized and aligned with precision. Ideal for tablets and larger screens.
      </div>
    </div>

    <ul class="books grid">
      {
            books.map((b) => (
              <li class="book col-6">
                <a href={b.url} target="_blank">
                  <Figure src={b.cover} alt={b.alt} ratio="16 / 9" />
                </a>
                <h4 class="book-title">
                  <a href={b.url} target="_blank">{b.title}</a>
                </h4>
                <p class="author">{b.author}</p>
                <p class="purchase"></p>
              </li>
            ))
          }
    </ul>
  </section>
</section>


<style>
.page-section {
  padding-bottom: 0;
}

.books {
  list-style: none;
  margin-top: var(--space-xl);
}

.book {
  margin-bottom: var(--space-m);

  a {
    text-decoration: none;
  }
}

.book-title {
  margin-top: var(--space-s);
  margin-bottom: 0.1em;
}

.author {
  margin-top: 0.25em;
}

.purchase {
  margin-top: 1.5rem;

  a {
    text-decoration: underline;
  }
}
</style>
