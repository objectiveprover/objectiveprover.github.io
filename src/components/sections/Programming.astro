---
import Figure from "@/components/Figure.astro";

type PetriLink = {
  label: string;
  url?: string;
  tools: string[];
}

import emacsImage from "@/assets/emacs.jpg";

const petriEntries: PetriLink[] = [
  {
    label: "Testing SCPI communication with an oscilloscope over a TCP socket",
    url: "https://github.com/objectiveprover/Petri/blob/master/3-scpi-tcp-connection.clj",
    tools: ["Clojure", "Networking"]
  },
  {
    label: "Simple web template engine",
    url: "https://github.com/objectiveprover/Petri/tree/master/5-web-templating-engine_ts",
    tools: ["TypeScript"]
  },
  {
    label: "Executing commands at random intervals",
    url: "https://github.com/objectiveprover/Petri/blob/master/1-random-wait.tcl",
    tools: ["Tcl", "Scripting"]
  },
  {
    label: "Collection of “Hello, world” files in different languages",
    url: "https://github.com/objectiveprover/Petri/tree/master/0-hello-world",
    tools: ["Various languages"]
  },
];


---

<section id="programming" class="page-section" aria-labelledby="programming-h">
  <h2 id="programming-h"><span class="index">3</span>&nbsp;&nbsp;Programming</h2>
  <div class="grid">
    <p class="col-6">
      At the moment most of my programming is experimental, and the amount of public code is
          minimal because I’ve worked on building websites for clients most of my career. I’m looking to expand my skills in different languages, especially live ones (which
          can be modified while they run) like a Lisp or Forth, but also high-integrity ones like
          Ada/SPARK.
    </p>
    <p class="col-6">For clients or employers, I welcome other more common programming languages like JavaScript/TypeScript, where I have the most experience in.</p>
  </div>

  <section class="page-subsection" aria-labelledby="emacs-h">
    <h3 id="emacs-h">
      <span class="index">3.1</span>&nbsp;&nbsp;Emacs
    </h3>
    <div class="grid">
      <div class="col-6">
        <Figure src={emacsImage} alt="Emacs Lisp code in my Emacs configuration" ratio="8 / 5" class="framed" />
      </div>
      <div class="col-6">
        <p>
          An Emacs configuration for a clear reading experience and to allow higher focus on code semantics by omitting high-contrast coloring of all syntax.
        </p>
        <p class="links"><a href="https://github.com/objectiveprover/.emacs.d">See on GitHub</a></p>
      </div>
    </div>
  </section>

  <section class="page-subsection" aria-labelledby="petri-h">
    <h3 id="petri-h"><span class="index">3.2</span>&nbsp;&nbsp;Petri</h3>

    <div class="grid">
      <div class="col-6">
        <p>
          Programs that don’t belong in a product or large project are stored in this repository, it works as a central place for testing ideas and learning/implementing algorithms.
        </p>
        <p class="links"><a href="https://github.com/objectiveprover/Petri">See on GitHub</a></p>
      </div>
    </div>

    <div class="petri-entries">
      <h4 class="list-heading">Latest Experiments:</h4>

      <ul class="titles">
        {petriEntries.map((e) => <li class="entry">
          <a class="entry-link" href={e.url}>{e.label}</a>
          <ul class="tool-tags">
            {e.tools.map(tool => <li class="tool-tag">{tool}</li>)}
          </ul>
        </li>)}
      </ul>
    </div>

  </section>
</section>

<style>
.petri-entries {
  margin-top: var(--space-2xl);
}

.titles {
  list-style: none;
  margin-top: var(--space-s);
}

.entry + .entry {
  margin-top: 0.25em;
  border-top: var(--line-size-1) solid black;
  padding-top: 0.5em;
}

.entry-link {
  text-decoration: none;
  position: relative;

  &::after {
    content: "↗";
    position: absolute;
    top: 50%;
    line-height: 0.5;
    right: -1em;
    opacity: 0;
  }

  &:hover,
    &:focus {
      text-decoration: none !important;

      &::after {
        opacity: 1;
      }
    }
}

.list-heading {
  font-size: var(--font-size-0);
  margin-bottom: 0;
}

.entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tool-tags {
  list-style: none;
  display: flex;
  font-size: var(--font-size--1);
  gap: 0.5em;
}

.tool-tag {
  display: inline-block;
  border: 1px solid black;
  line-height: 1;
  border-radius: 1em;
  padding: 0.25em 0.5em;
  font-size: var(--font-size--1);
}

</style>
